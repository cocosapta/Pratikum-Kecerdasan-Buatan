        <Component class="javax.swing.JCheckBox" name="jCheckBox1">
          <Properties>
            <Property name="text" type="java.lang.String" value="Suhu 37.5&#x2013;39&#xb0;C, suhu meningkat  bertahap, menggigil ringan"/>
